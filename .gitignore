# ==============================================================================
# Lexora — Root Git Ignore Rules
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets (NEVER commit secrets to version control)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
# Ensure environment example templates are ALWAYS tracked:
!.env.example
!**/.env.example

# Build Outputs & Bundles
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.vuepress/dist/
.serverless/
.fusebox/
.dynamodb/
.vite/

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime / Temp Data
*.tmp
*.temp
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Database & Storage
*.sqlite
*.sqlite3
*.db
*.db-journal
*.dump

# Test Coverage & Reports
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/

# Operating System Files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# IDE & Editor Configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
