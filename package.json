{
  "name": "document-intake-assistant",
  "version": "1.0.0",
  "description": "AI-assisted conversational document intake system for Lexora",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "test": "npm run test --workspace=server"
  },
  "keywords": [
    "legal-tech",
    "conversational-ai",
    "document-generation",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
